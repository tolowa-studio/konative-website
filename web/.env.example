# ------------------------------------------
# Konative environment template
# Copy to .env.local and replace placeholders.
# ------------------------------------------

# Database connection string (required)
# Vercel Postgres format:
# postgres://<user>:<password>@<host>:5432/<database>?sslmode=require
DATABASE_URI=postgres://<user>:<password>@<host>:5432/<database>?sslmode=require

# Payload secret (required, random 32+ chars)
PAYLOAD_SECRET=REPLACE_WITH_RANDOM_32_CHAR_SECRET

# Canonical site URL (required)
NEXT_PUBLIC_SITE_URL=https://konative.com

# Vercel Blob read/write token (required for media uploads)
BLOB_READ_WRITE_TOKEN=REPLACE_WITH_VERCEL_BLOB_RW_TOKEN

# Transactional email (recommended for form notifications)
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
RESEND_FROM_EMAIL=hello@konative.com

# Error tracking — GlitchTip (Sentry-SDK compatible, self-hosted on Railway)
# DSN from: https://glitchtip-web-production-de20.up.railway.app → Projects → your project → Keys
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Langfuse — LLM/agent observability (self-hosted on Railway)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASEURL=https://langfuse-web-production-1484.up.railway.app

# Supabase — konative-intel project
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional analytics (Google Tag Manager)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# News ingest API (/api/ingest-news) — set in Vercel if you use cron or external triggers
NEWS_INGEST_TOKEN=REPLACE_WITH_RANDOM_SECRET_FOR_INGEST_API
