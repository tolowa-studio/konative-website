# Keep the Docker build context small — the repo history includes large PMTiles artifacts.
.git
.github
**/.git
**/.next
**/node_modules
**/.open-next
**/.turbo
**/.vercel
**/.env*
!web/.env.local.example
!web/.env.example

# Large tile binaries (manifest JSON is bundled at build time via imports)
tiles/
**/*.pmtiles
web/data/
web/content/
# NOTE: web/scripts/ is intentionally NOT excluded — API routes (queue/ingest,
# ingest-canada-queue) import runtime logic from it (e.g.
# web/scripts/promoteCanadaQueue.ts). Excluding it broke the Cloud Run Docker
# build (2026-08-18): "Module not found: Can't resolve '../../../../../scripts/...'"
docs/
.context/
conductor/
*.md
!web/README.md

# Tooling / IDE
.cursor
.vscode
.idea
**/__tests__
**/*.test.ts
**/*.test.tsx
coverage/
playwright-report/
test-results/

# Misc
scripts/vercel-bootstrap.sh
.DS_Store
*.log
tmp/
dist/
